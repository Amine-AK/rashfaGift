# ── Database ───────────────────────────────────────────────────────────────
# Supabase → Project Settings → Database → Connection string → "Transaction pooler" (port 6543).
DATABASE_URL=postgresql://postgres.xxxxx:password@aws-0-eu-west-3.pooler.supabase.com:6543/postgres

# ── Secrets (generate each with: openssl rand -base64 48) ──────────────────
SESSION_SECRET=
QR_SECRET=
CRON_SECRET=

# Public URL of the app (used in push notifications and referral links).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Login codes by SMS (Twilio) ────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Development only: shows the login code on screen instead of sending an SMS.
# NEVER set this to true in production.
OTP_DEV_MODE=true

# ── Web Push (generate with: npm run vapid:generate) ───────────────────────
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@rashfa.ma

# ── Supabase (optional: live flash counters + menu photo uploads) ──────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
